# This project runs fully locally using Ollama — no cloud API keys required.
# Install Ollama from https://ollama.com, then pull the two models this
# pipeline uses:
#   ollama pull llama3.2
#   ollama pull nomic-embed-text

# Base URL where your local Ollama server is listening (default is fine
# for a standard local install).
OLLAMA_BASE_URL=http://localhost:11434

# Model used for chat/reasoning tasks: information extraction, scoring,
# interview question generation, rejection email drafting.
OLLAMA_LLM_MODEL=llama3.2

# Model used to generate embeddings for the Job Description (stored in
# ChromaDB) and for candidate skill/experience text (for cosine similarity).
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
